#!/bin/bash
# MarkView - Markdown Viewer for macOS
# Launches the PowerShell engine to render markdown in the browser.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# In app/staged layout, pwsh is beside app/; in dev layout use system pwsh.
if [ -x "$SCRIPT_DIR/../pwsh/pwsh" ]; then
    PWSH="$SCRIPT_DIR/../pwsh/pwsh"
else
    PWSH="pwsh"
fi

# Resolve the app directory (Open-Markdown.ps1 location).
if [ -d "$SCRIPT_DIR/../app" ]; then
    APP_DIR="$SCRIPT_DIR/../app"
else
    # Development layout: src/mac/markview -> src/core/Open-Markdown.ps1
    APP_DIR="$SCRIPT_DIR/../core"
fi

exec "$PWSH" -NoProfile -ExecutionPolicy Bypass \
    -File "$APP_DIR/Open-Markdown.ps1" -Path "$1"
