<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <!-- Windows GUI subsystem app (no console window) -->
    <OutputType>WinExe</OutputType>

    <!-- Target .NET Framework 4.8.1 (pre-installed on Windows 11) -->
    <TargetFramework>net481</TargetFramework>

    <!-- Enable Windows Forms for help dialog -->
    <UseWindowsForms>true</UseWindowsForms>
    
    <!-- 
      .NET Framework doesn't use RuntimeIdentifiers. Clear any RID passed by WAP project
      to prevent NETSDK1047 errors during MSIX packaging builds.
    -->
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>

    <!-- Assembly info -->
    <AssemblyName>MarkdownViewerHost</AssemblyName>
    <RootNamespace>MarkdownViewerHost</RootNamespace>
    <Version>1.4.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <Product>MarkView</Product>
    <Company></Company>
    <Copyright>MIT License</Copyright>
    <Description>Host application for MarkView MSIX package</Description>
    <ApplicationIcon>..\..\core\icons\markdown.ico</ApplicationIcon>
    <NeutralLanguage>en-us</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\core\icons\markdown.ico">
      <LogicalName>AppIconResource</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- WinRT contracts to compile against Windows.ApplicationModel activation APIs -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" />
  </ItemGroup>
</Project>
